{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["node"],
  "env": { "node": true },
  "globals": { "Bun": "readonly" },
  "rules": {
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }]
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "test/**/*.ts"],
      "rules": { "no-console": "off" }
    }
  ]
}
