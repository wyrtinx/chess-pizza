# Скопіюйте у .env (розробка) і .env.test (тести) та заповніть значення.
# Bun сам читає .env, а під час `bun test` — ще й .env.test (він має пріоритет).

# development | test | production
NODE_ENV=

# Порт HTTP-сервера
PORT=

# Рядок підключення до PostgreSQL.
# Локально (docker compose): postgresql://chess:chess@localhost:5432/chess_pizza
# У .env.test — база chess_pizza_test
DATABASE_URL=
