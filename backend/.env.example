# Скопіюйте у .env (розробка) і .env.test (тести) та заповніть значення.
# Bun сам читає .env, а під час `bun test` — ще й .env.test (він має пріоритет).

# development | test | production
NODE_ENV=

# Порт HTTP-сервера
PORT=

# Рядок підключення до PostgreSQL.
# Локально (docker compose): postgresql://chess:chess@localhost:5432/chess_pizza
# У .env.test — база chess_pizza_test
DATABASE_URL=

# Дозволені origin фронтенду через кому (CORS з credentials).
# Локально: http://localhost:5173
CORS_ORIGINS=

# Скільки проксі стоїть перед застосунком: 0 — жодного (локально), 1 — за проксі хостингу.
# Від цього залежить req.ip, за яким рахуються ліміти запитів.
TRUST_PROXY=

# true — документація API (Scalar) на /docs
DOCS_ENABLED=

# fatal | error | warn | info | debug | trace | silent (у .env.test зручно silent)
LOG_LEVEL=

# Ліміт розміру JSON-тіла запиту, наприклад 100kb
BODY_LIMIT=
