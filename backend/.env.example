# Скопіюйте у .env (розробка) і .env.test (тести) та заповніть значення.
# Bun сам читає .env, а під час `bun test` — ще й .env.test (він має пріоритет).

# development | test | production
NODE_ENV=

# Порт HTTP-сервера
PORT=

# Рядок підключення до PostgreSQL.
# Локально (docker compose): postgresql://chess:chess@localhost:5432/chess_pizza
# У .env.test — база chess_pizza_test
DATABASE_URL=

# Дозволені origin фронтенду через кому (CORS з credentials).
# Локально: http://localhost:5173
CORS_ORIGINS=

# Скільки проксі стоїть перед застосунком: 0 — жодного (локально), 1 — за проксі хостингу.
# Від цього залежить req.ip, за яким рахуються ліміти запитів.
TRUST_PROXY=

# true — документація API (Scalar) на /docs
DOCS_ENABLED=

# fatal | error | warn | info | debug | trace | silent (у .env.test зручно silent)
LOG_LEVEL=

# Ліміт розміру JSON-тіла запиту, наприклад 100kb
BODY_LIMIT=

# SMTP для пошти. Локально й у тестах — Mailpit із docker compose:
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, SMTP_USER і SMTP_PASS порожні.
# На проді — Gmail: smtp.gmail.com, 465, true.
SMTP_HOST=
SMTP_PORT=
# true — TLS одразу (порт 465), false — без TLS або STARTTLS (Mailpit, порт 587)
SMTP_SECURE=

# Логін і пароль SMTP. Обов'язкові лише на проді (Gmail + «пароль застосунку»).
SMTP_USER=
SMTP_PASS=

# Відправник листів: «Ім'я <адреса>». У Gmail адреса має збігатися з акаунтом.
# Локально: Chess Pizza <noreply@chesspizza.local>
MAIL_FROM=

# Лише для smoke-тестів (.env.test): HTTP API Mailpit, з якого тести читають листи.
# Локально: http://localhost:8025
MAILPIT_API_URL=
