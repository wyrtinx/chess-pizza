generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "bun"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  PIZZA
  DRINK
  DESSERT

  @@map("product_category")
}

model Product {
  id           String          @id @default(uuid(7)) @db.Uuid
  name         Json
  description  Json?
  category     ProductCategory
  basePrice    Int             @map("base_price")
  weightGrams  Int?            @map("weight_grams")
  volumeMl     Int?            @map("volume_ml")
  isVegetarian Boolean         @default(false) @map("is_vegetarian")
  spicyLevel   Int             @default(0) @map("spicy_level") @db.SmallInt
  isVisible    Boolean         @default(true) @map("is_visible")
  imageKey     String?         @map("image_key")
  sortOrder    Int             @default(0) @map("sort_order")
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([isVisible, deletedAt])
  @@map("products")
}

model Topping {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      Json
  price     Int
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("toppings")
}

model Pizzeria {
  id        String   @id @default(uuid(7)) @db.Uuid
  address   Json
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pizzerias")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum Locale {
  uk
  en

  @@map("locale")
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("code_purpose")
}

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  email             String        @unique
  passwordHash      String        @map("password_hash")
  name              String
  phone             String?
  address           String?
  role              Role          @default(USER)
  locale            Locale
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  termsAcceptedAt   DateTime      @map("terms_accepted_at") @db.Timestamptz(3)
  bonusBalance      Int           @default(0) @map("bonus_balance")
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          AuthSession[]
  oneTimeCodes      OneTimeCode[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([familyId])
  @@index([userId])
  @@map("auth_sessions")
}

model OneTimeCode {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    CodePurpose
  codeHash   String      @map("code_hash")
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  attempts   Int         @default(0)
  lastSentAt DateTime    @map("last_sent_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, purpose])
  @@map("one_time_codes")
}
