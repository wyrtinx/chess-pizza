{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Перевіряє, що застосунок працює й база даних відповідає.\nВикористовується хостингом і Docker healthcheck.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "`INTERNAL_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Стан сервісу",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "description": "Усі видимі товари одним списком, без пагінації: спершу найпопулярніші.\nПошук, категорії, «Вегетаріанське» й сортування робить фронтенд.\nПриховані й видалені товари не віддаються.",
        "operationId": "ProductsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Вітрина",
        "tags": [
          "products"
        ]
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "description": "Прихований або видалений товар — `404`, як і неіснуючий.",
        "operationId": "ProductsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Ідентифікатор (UUID).",
            "schema": {
              "format": "uuid",
              "example": "0199a3f2-7c1e-7b7a-9f0e-2d6c5a4b3c21",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "`PRODUCT_NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Товар за ідентифікатором",
        "tags": [
          "products"
        ]
      }
    },
    "/api/v1/pizzerias": {
      "get": {
        "description": "Точки, де можна забрати замовлення. На ціну вибір піцерії не впливає.",
        "operationId": "PizzeriasController_findActive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PizzeriaResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Піцерії для самовивозу",
        "tags": [
          "pizzerias"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Числа, за якими сервер рахує ціни й знижки: опції піци, добавки, доставка, самовивіз,\nбонуси, години роботи. Фронтенд бере їх звідси й не дублює в коді.\nОстаточну ціну завжди рахує сервер.",
        "operationId": "MetaController_getMeta",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponseDto"
                }
              }
            }
          }
        },
        "summary": "Публічні константи",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "description": "Ім’я, пошта й статус підтвердження, телефон і адреса з першого замовлення, баланс бонусів.",
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` · `TOKEN_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cp_at": []
          }
        ],
        "summary": "Профіль поточного користувача",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Створює акаунт, одразу відкриває сесію (cookie `cp_at` і `cp_rt`) і надсилає код підтвердження на пошту.\nНепідтверджена пошта не заважає входу й замовленням — лише бонусам і знижці першого замовлення.\nЛіміт — 5 запитів на 15 хв для однієї пошти з однієї IP-адреси.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "`EMAIL_TAKEN`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Реєстрація",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "description": "Код із листа діє 10 хв; на один код — 5 спроб, далі потрібен новий код.\nЛіміт — 10 запитів на 15 хв з однієї IP-адреси.",
        "operationId": "AuthController_verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED` · `CODE_INVALID` · `CODE_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` · `TOKEN_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "`EMAIL_ALREADY_VERIFIED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "`CODE_ATTEMPTS_EXCEEDED` · `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cp_at": []
          }
        ],
        "summary": "Підтвердження пошти кодом",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify-email/resend": {
      "post": {
        "description": "Не частіше ніж раз на 60 с. Новий код замінює попередній.\nЯкщо зарано — `429 RESEND_TOO_SOON` із заголовком `Retry-After` (секунди).",
        "operationId": "AuthController_resendCode",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendCodeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` · `TOKEN_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "`EMAIL_ALREADY_VERIFIED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "`RESEND_TOO_SOON` · `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cp_at": []
          }
        ],
        "summary": "Надіслати код підтвердження знову",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Відкриває нову сесію (cookie `cp_at` і `cp_rt`). Невірна пошта й невірний пароль дають ту саму помилку.\nЛіміт — 5 запитів на 15 хв для однієї пошти з однієї IP-адреси.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_CREDENTIALS`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Вхід",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Обмінює refresh-cookie `cp_rt` на нові `cp_at` і `cp_rt`; старий refresh після цього недійсний.\nПовторне використання старого refresh відкликає всю сесію (`SESSION_REUSED`).\nФронтенд має робити один refresh на всі вкладки одночасно.\nПри помилці обидві cookie стираються.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`SESSION_INVALID` · `SESSION_REUSED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Оновити сесію",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Відкликає сесію за refresh-cookie і стирає обидві cookie. Діє і з простроченим access-токеном.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Вихід",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "Для гостя — `{ user: null }` без помилки.\n`401 TOKEN_EXPIRED` — access-токен прострочений: зробіть `POST /auth/refresh` і повторіть запит.",
        "operationId": "AuthController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` · `TOKEN_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cp_at": []
          }
        ],
        "summary": "Поточна сесія",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Chess Pizza API",
    "description": "API сайту Chess Pizza: вітрина, кошик, оформлення, профіль із бонусами, адмін-панель.\n\nГроші — цілі числа в копійках, дати — ISO 8601 в UTC.\n\nУсі помилки мають один формат (`ErrorResponseDto`): машинний `code`, для помилок полів — `details`, і `requestId`, що збігається із заголовком `X-Request-Id`.\nБудь-який ендпоінт може відповісти `429 RATE_LIMITED` (із заголовком `Retry-After`) і `500 INTERNAL_ERROR`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_at"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Стан сервісу. Завжди `ok`: якщо база даних недоступна, відповідь — `503`.",
            "example": "ok",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHORIZED",
          "TOKEN_EXPIRED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "INVALID",
          "REQUIRED",
          "NAME_TOO_SHORT",
          "NAME_REQUIRED",
          "EMAIL_INVALID",
          "PASSWORD_TOO_SHORT",
          "PHONE_INVALID",
          "ADDRESS_INVALID",
          "TERMS_NOT_ACCEPTED",
          "PRICE_INVALID",
          "PIZZA_PRICE_TOO_LOW",
          "QUANTITY_INVALID",
          "PIZZERIA_REQUIRED",
          "CURSOR_INVALID",
          "CODE_FORMAT_INVALID",
          "UNKNOWN_FIELD",
          "EMAIL_TAKEN",
          "INVALID_CREDENTIALS",
          "EMAIL_ALREADY_VERIFIED",
          "CODE_INVALID",
          "CODE_EXPIRED",
          "CODE_ATTEMPTS_EXCEEDED",
          "RESEND_TOO_SOON",
          "SESSION_INVALID",
          "SESSION_REUSED",
          "RESET_TOKEN_INVALID",
          "RESET_TOKEN_EXPIRED",
          "PRODUCT_NOT_FOUND",
          "PRODUCT_UNAVAILABLE",
          "PRODUCT_OPTIONS_INVALID",
          "CART_ITEM_NOT_FOUND",
          "CART_LIMIT_EXCEEDED",
          "CART_EMPTY",
          "CART_HAS_UNAVAILABLE_ITEMS",
          "ORDER_NOT_FOUND",
          "ORDER_STATUS_TRANSITION_INVALID",
          "PIZZERIA_NOT_FOUND",
          "SLOT_UNAVAILABLE",
          "BONUSES_UNAVAILABLE",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_MISMATCH",
          "FILE_REQUIRED",
          "FILE_TOO_LARGE",
          "FILE_TYPE_NOT_ALLOWED"
        ],
        "description": "Машинний код помилки. Текст для людини підставляє фронтенд."
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "description": "Машинний код помилки поля. Текст для людини підставляє фронтенд.",
            "example": "QUANTITY_INVALID",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "field": {
            "type": "string",
            "description": "Поле запиту, якого стосується помилка. Вкладені поля — через крапку.",
            "example": "items.0.quantity"
          }
        },
        "required": [
          "code",
          "field"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "description": "Машинний код помилки. Текст для людини підставляє фронтенд.",
            "example": "VALIDATION_FAILED",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "statusCode": {
            "type": "number",
            "description": "HTTP-статус відповіді.",
            "example": 400
          },
          "message": {
            "type": "string",
            "description": "Короткий опис англійською — для розробника, не для показу користувачу.",
            "example": "Validation failed"
          },
          "details": {
            "description": "Помилки окремих полів. Є лише там, де помилка стосується конкретних полів запиту.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "requestId": {
            "type": "string",
            "description": "Ідентифікатор запиту — той самий, що в заголовку `X-Request-Id`.",
            "example": "0199a3f2-7c1e-7b7a-9f0e-2d6c5a4b3c21"
          }
        },
        "required": [
          "code",
          "statusCode",
          "message",
          "requestId"
        ]
      },
      "ProductCategory": {
        "type": "string",
        "enum": [
          "PIZZA",
          "DRINK",
          "DESSERT"
        ],
        "description": "Категорія. Розмір, тісто й добавки є лише в піци."
      },
      "LocalizedTextDto": {
        "type": "object",
        "properties": {
          "uk": {
            "type": "string",
            "description": "Текст українською.",
            "example": "Маргарита"
          },
          "en": {
            "type": "string",
            "description": "Текст англійською. Якщо його немає, фронтенд показує український.",
            "example": "Margherita"
          }
        },
        "required": [
          "uk"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "category": {
            "description": "Категорія. Розмір, тісто й добавки є лише в піци.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductCategory"
              }
            ]
          },
          "id": {
            "type": "string",
            "description": "Ідентифікатор товару (UUID).",
            "example": "0199a3f2-7c1e-7b7a-9f0e-2d6c5a4b3c21"
          },
          "name": {
            "description": "Назва.",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizedTextDto"
              }
            ]
          },
          "description": {
            "nullable": true,
            "description": "Склад або короткий опис.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizedTextDto"
              }
            ]
          },
          "basePrice": {
            "type": "number",
            "description": "Ціна у копійках. Для піци — ціна розміру 30 см; надбавки за розмір і добавки — у `GET /meta`.",
            "example": 24900
          },
          "weightGrams": {
            "type": "number",
            "nullable": true,
            "description": "Вага у грамах (для піци — розміру 30 см). `null` — для напоїв.",
            "example": 520
          },
          "volumeMl": {
            "type": "number",
            "nullable": true,
            "description": "Об’єм у мілілітрах. `null` — для всього, крім напоїв."
          },
          "isVegetarian": {
            "type": "boolean",
            "description": "Вегетаріанське."
          },
          "spicyLevel": {
            "type": "number",
            "description": "Гострота від 0 до 4. Мітка «Гостре» — від 3.",
            "example": 0
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Адреса фото. `null` — фото немає, фронтенд показує заглушку."
          },
